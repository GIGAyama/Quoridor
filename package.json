{
  "name": "kabe-kabe-gassen",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/build-sw.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "icons": "node tools/build-icons.mjs",
    "gate": "node scripts/check-project.mjs",
    "gate:self-test": "node scripts/check-project.mjs --self-test",
    "measure:ui": "node tools/measure-ui.mjs dist",
    "measure:pwa": "node tools/measure-pwa.mjs dist",
    "measure:a11y": "node tools/measure-a11y.mjs dist",
    "measure:icons": "node tools/measure-icons.mjs dist",
    "measure:boot": "node tools/measure-boot.mjs dist",
    "measure": "npm run measure:ui && npm run measure:pwa && npm run measure:a11y && npm run measure:icons && npm run measure:boot",
    "check": "npm run lint && npm run test && node tools/check-secrets.mjs && npm run build && npm run gate && npm run measure",
    "check:secrets": "node tools/check-secrets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.5"
  }
}
