{
  "$comment": [
    "品質ゲートの設定。GIGA Standard v5 Part I の検査に対応する。",
    "repoName は manifest の id / scope / start_url に使う絶対パスの元になる。",
    "しきい値はすべて Part I に書かれている値で、勝手に緩めない。"
  ],
  "repoName": "Quoridor",
  "appType": "B",
  "cachePrefix": "kabe-kabe-",
  "limits": {
    "maxFileLines": 5000,
    "maxFileKB": 400,
    "maxImageKB": 150,
    "maxIcon512KB": 60,
    "maxFaviconKB": 30,
    "maxInitialJsKB": 300,
    "maxMaskableOutsideSafeZonePct": 0.2
  },
  "measured": {
    "$comment": "実ブラウザで測るものは tools/ 側で測る。ここには静的に見るものだけ書く。",
    "uiScript": "tools/measure-ui.mjs",
    "pwaScript": "tools/measure-pwa.mjs",
    "a11yScript": "tools/measure-a11y.mjs",
    "iconScript": "tools/measure-icons.mjs"
  },
  "standard": {
    "//": "正本 GIGAyama.github.io/standards/lib/giga-v5-checks.mjs に渡す設定。",
    "repoName": "Quoridor",
    "sw": "vite",
    "swSource": "public/sw.js",
    "swVersionConst": "APP_VERSION",
    "manifest": "public/manifest.webmanifest",
    "//siteRoot": "Vite 型なので public/ の中身が配信の直下に来る。ここを書かないと offline.html とアイコンを「ありません」と誤検知する。",
    "siteRoot": "public",
    "jsDirs": [
      "src"
    ],
    "cssDirs": [
      "src"
    ],
    "htmlFiles": [
      "index.html",
      "public/offline.html"
    ],
    "imageDirs": [
      "public"
    ],
    "skips": [
      {
        "id": "C_PAGEHIDE",
        "reason": "このアプリは1台の端末を2人で囲んで指すもので、対局結果を保存しない（localStorage も IndexedDB も使っていない）。締めて確定する記録が無いので pagehide の出番が無い（2026-08-22）"
      }
    ]
  }
}
